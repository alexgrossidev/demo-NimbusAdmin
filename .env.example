# Base URL of the backend API the app talks to.
# NOTE: this repo has no backend — the app runs entirely against in-memory mocks
# (see src/FEATUREFLAGS.ts, MOCK_LOGIN). Set this only when wiring a real API.
VITE_API_URL=http://localhost:3000

# Title shown in the app shell / document.
VITE_APP_TITLE=Nimbus Admin
